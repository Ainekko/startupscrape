# Database (PostgreSQL — can share the same Neon/Supabase DB instance as sms-saas)
# Tables are automatically prefixed with 'startupscrape_' to prevent collisions
DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require

# Authentication
JWT_SECRET_KEY=change-this-to-a-secure-secret-in-production

# Pipeline Enrichment & Identity
TREG_TOKEN=

# Browserbase API (https://browserbase.com)
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=
BROWSERBASE_LINKEDIN_CONTEXT_ID=

# Gemini API (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Algolia API (Optional overrides)
YC_ALGOLIA_APP_ID=
YC_ALGOLIA_API_KEY=
WAAS_ALGOLIA_APP_ID=
WAAS_ALGOLIA_API_KEY=
